# Copy to .env and fill in. NEVER commit the real .env.
# Owner connection: used ONLY by migrations / seed scripts (needs CREATE ROLE + CREATE EXTENSION rights, e.g. a superuser).
DATABASE_URL_ADMIN=postgresql://postgres:CHANGE_ME@localhost:5432/clubconnect
# Restricted login role created by migration 004. The web app connects with this one.
DATABASE_URL=postgresql://clubconnect_app:CHANGE_ME_APP@localhost:5432/clubconnect
DB_APP_PASSWORD=CHANGE_ME_APP

MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=clubconnect

# Random string, at least 32 characters (e.g. `openssl rand -base64 48`)
SESSION_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
